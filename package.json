{
  "name": "native-site-editor",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "wrangler dev --port 8787 --local-upstream 127.0.0.1:8787",
    "dev:ui": "vite --host 127.0.0.1",
    "build:ui": "vite build",
    "check": "tsc --noEmit && tsc -p worker/tsconfig.json --noEmit && node scripts/check-unused.mjs && node scripts/check-specs.mjs",
    "deploy": "wrangler deploy",
    "deploy:techies": "wrangler deploy --config wrangler.techies.jsonc",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test --project=native-save",
    "test:browser-preview": "playwright test --project=native-preview",
    "deploy:preview": "wrangler deploy --config wrangler.preview.jsonc",
    "test:browser:default": "node --import tsx scripts/native-browser-tests.mjs default",
    "test:browser:actual": "node --import tsx scripts/native-browser-tests.mjs actual",
    "test:browser:native-static": "node --import tsx scripts/native-browser-tests.mjs native-static",
    "test:browser:shared-authoring": "playwright test --project=native-shared-authoring",
    "test:browser:shared-structure": "playwright test --project=native-shared-structure",
    "test:browser:page-part-preview": "playwright test --project=native-page-part-preview",
    "test:browser:all": "playwright test",
    "test:browser:smoke": "playwright test --grep @smoke --grep-invert \"@actual|@native-static\"",
    "test:budget": "tsx tests/perf/byte-budget.ts",
    "lint": "eslint"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@modelcontextprotocol/client": "^2.2.0",
    "@phosphor-icons/core": "^2.1.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24",
    "esbuild": "0.28.1",
    "eslint": "^10.12.0",
    "libsodium-wrappers": "^0.8.4",
    "miniflare": "5.20261001.0-alpha",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "typescript-eslint-api": "npm:typescript@~6.0.3",
    "vite": "^8.3.2",
    "wrangler": "^4.146.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.2.0",
    "@preact/signals-core": "^1.14.4",
    "blakejs": "^1.2.1",
    "monaco-editor": "^0.56.0",
    "tweetnacl": "^1.0.3",
    "zod": "^4.6.5"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.16"
    },
    "typescript-eslint": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/eslint-plugin": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/parser": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/project-service": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/tsconfig-utils": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/type-utils": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/typescript-estree": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/utils": {
      "typescript": "$typescript"
    }
  },
  "cloudflare": {
    "bindings": {
      "OWNER_GITHUB": {
        "description": "Your **GitHub username**. The first time you open the editor, it creates its own GitHub App on that account, and only that account can."
      }
    }
  }
}
