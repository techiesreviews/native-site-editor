{
  "name": "native-site-editor",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build:ui && wrangler dev --config wrangler.sessions.jsonc --port 8787 --local-upstream 127.0.0.1:8787",
    "dev:pages": "npm run build:ui && wrangler pages dev dist",
    "dev:ui": "vite --host 127.0.0.1",
    "build:ui": "vite build",
    "build:functions": "wrangler pages functions build --outdir .scratch/pages-functions",
    "build": "npm run check && npm run build:ui && npm run build:functions",
    "check": "tsc --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "deploy": "npm run build:ui && wrangler deploy --config wrangler.sessions.jsonc",
    "deploy:sessions": "wrangler deploy --config wrangler.sessions.jsonc",
    "deploy:pages": "npm run build:ui && wrangler pages deploy dist --project-name native-site-editor",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test -c playwright.native-save.config.ts",
    "test:browser-preview": "playwright test -c playwright.native-preview.config.ts",
    "setup": "node scripts/setup-browser.mjs",
    "setup:manual": "bash scripts/setup-github.sh",
    "setup:browser": "node scripts/setup-browser.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "esbuild": "0.28.2",
    "miniflare": "5.20260916.0-alpha",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.133.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "monaco-editor": "^0.56.0",
    "zod": "^4.6.5"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.15"
    },
    "undici": "7.29.1"
  }
}
