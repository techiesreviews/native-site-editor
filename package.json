{
  "name": "native-site-editor",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev --port 8787 --local-upstream 127.0.0.1:8787",
    "dev:ui": "vite --host 127.0.0.1",
    "build:ui": "vite build",
    "check": "tsc --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "deploy": "wrangler deploy",
    "deploy:techies": "wrangler deploy --config wrangler.techies.jsonc",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test -c playwright.native-save.config.ts",
    "test:browser-preview": "playwright test -c playwright.native-preview.config.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@phosphor-icons/core": "^2.1.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "esbuild": "0.28.2",
    "libsodium-wrappers": "^0.8.4",
    "miniflare": "5.20260916.0-alpha",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.133.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "blakejs": "^1.2.1",
    "monaco-editor": "^0.56.0",
    "tweetnacl": "^1.0.3",
    "zod": "^4.6.5"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.15"
    },
    "undici": "7.29.1"
  },
  "cloudflare": {
    "bindings": {
      "OWNER_GITHUB": {
        "description": "Your **GitHub username**. The first time you open the editor, it creates its own GitHub App on that account, and only that account can."
      }
    }
  }
}
