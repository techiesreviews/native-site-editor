{
  // Test deployment target. On every push to main the GitHub Actions workflow
  // in .github/workflows/deploy.yml runs `wrangler deploy`, which uploads the
  // repository as it is: the repository root is the site root, and there is
  // no build. .assetsignore keeps repository-only files off the site. Assets
  // only; there is no Worker script.
  "name": "native-site-editor-starter-test",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
