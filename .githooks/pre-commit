#!/bin/sh
# Runs npm run check, and lints the staged TypeScript, when a commit touches code or
# config. Docs-only commits skip it. Never runs browser suites. See docs/agents/guardrails.md.
# Enable once per clone with: git config core.hooksPath .githooks
# Skip once with: git commit --no-verify
set -e
root=$(git rev-parse --show-toplevel)
cd "$root"

# Deletions count: removing an imported module must still run the type check.
staged=$(git diff --cached --name-only --diff-filter=ACMRD)
code=$(printf '%s\n' "$staged" | grep -E '^(src|shared|worker|tests|scripts|tools|\.githooks)/|^(package(-lock)?\.json|tsconfig\.json|eslint\.config\.mjs|vite\.config\.ts|vite-monaco-trim\.ts|playwright\.config\.ts|wrangler[^/]*\.jsonc)$' || true)
[ -n "$code" ] || exit 0

if [ ! -d node_modules ]; then
  echo "pre-commit: no node_modules in this worktree, skipping check and lint."
  exit 0
fi

npm run --silent check
# Only files that still exist go to ESLint.
lint=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^(src|shared|worker|tests)/.*\.ts$' || true)
[ -n "$lint" ] || exit 0
# Every package eslint.config.mjs imports must resolve, or lint is skipped.
if ! node -e 'for (const name of ["eslint", "typescript-eslint", "typescript-eslint-api"]) require.resolve(name)' 2>/dev/null; then
  echo "pre-commit: lint skipped: run npm ci to enable."
  exit 0
fi
# shellcheck disable=SC2086 # one path per word; repository paths have no spaces.
npx --no-install eslint $lint
