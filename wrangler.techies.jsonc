{
  // The reference deployment at https://editor.techies.tools. Self-hosting uses
  // `wrangler.jsonc` (the Deploy to Cloudflare button) instead.
  //
  // Same Worker as `wrangler.jsonc`: it owns the SQLite-backed SessionStore
  // Durable Object, runs `worker/app.ts` for `/api/*`, `/auth/*`, `/mcp` and the
  // MCP OAuth metadata under `/.well-known/`, and serves the built UI from
  // `dist` (with `public/_headers` applied). Its name predates the Pages
  // fallback's retirement and stays, since renaming would lose the Durable
  // Object's sessions and GitHub App. Deploy with `npm run deploy:techies`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "native-site-editor-sessions",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-17",
  "workers_dev": false,
  // Workers Logs keep the causes of unexpected errors (logged in worker/app.ts).
  "observability": { "enabled": true },
  "build": { "command": "npm run build:ui" },
  "routes": [{ "pattern": "editor.techies.tools", "custom_domain": true }],
  // The editor's own address (owner setup and GitHub's return address), and
  // other addresses serving the same editor, which get sign-in callbacks.
  // Self-hosting: set EDITOR_ORIGIN to your address and drop EDITOR_ALIASES.
  "vars": {
    "EDITOR_ORIGIN": "https://editor.techies.tools",
    "EDITOR_ALIASES": "https://native-site-editor.pages.dev",
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*", "/mcp", "/.well-known/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "SessionStore" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionStore"] }],
}
