/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; worker-src 'self'; img-src 'self' data: blob: https: https://avatars.githubusercontent.com; font-src 'self' data:; connect-src 'self' https: https://i.ytimg.com https://www.youtube.com https://vimeo.com https://i.vimeocdn.com https://*.workers.dev; media-src 'self' blob:; frame-src 'self' https://*.workers.dev https://www.youtube-nocookie.com https://www.youtube.com https://player.vimeo.com; base-uri 'none'; frame-ancestors 'none'; form-action 'self'

/assets/*
  Cache-Control: public, max-age=31536000, immutable
