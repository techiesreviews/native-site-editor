:host {
  display: block;
}

/* Each part is a whole element in a slot. components.js gives every rule a
   ::slotted() twin, so a rule styles the template's fallback and what a page
   slots in alike. */

section {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding: var(--space-xl);
  border-radius: var(--radius-l);
  background: var(--surface);
}

h2 {
  margin: 0;
  font-size: var(--text-2xl);
}

p {
  margin: 0;
}

.body {
  max-width: var(--reading-width);
  color: var(--muted);
  line-height: 1.55;
}

.action {
  font-weight: 600;
}

.action a {
  color: var(--accent);
}
