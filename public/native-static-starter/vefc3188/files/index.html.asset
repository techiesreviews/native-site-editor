  <script type="module" src="/components/components.js"></script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "ProfessionalService",
          "@id": "https://native-site-editor-starter-test.lexvd.workers.dev/#organization",
          "name": "Larkspur Studio",
          "url": "https://native-site-editor-starter-test.lexvd.workers.dev/",
          "description": "Larkspur is a two-person design studio in Frome, Somerset, building small, useful websites from plain HTML and CSS.",
          "email": "hello@larkspur.example",
          "foundingDate": "2019",
          "areaServed": "Somerset",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Frome",
            "addressRegion": "Somerset",
            "addressCountry": "GB"
          }
        },
        {
          "@type": "WebSite",
          "name": "Larkspur Studio",
          "url": "https://native-site-editor-starter-test.lexvd.workers.dev/",
          "description": "Larkspur is a two-person design studio in Frome, Somerset, building small, useful websites from plain HTML and CSS.",
