// Online videos: YouTube and Vimeo videos that stay on their service. The
// markup is described in scripts/media-player.js, which loads this module
// only on pages that hold one and hands it the shared player parts.
//
// Before the tap nothing contacts the service: the visitor sees the still
// copied into the site and the site's play button. The tap loads the
// service's player (youtube-nocookie.com or player.vimeo.com) and its player
// API, hides the service's own bar and lays the site's bar over the picture.
// Whenever the service has to speak for itself (the video cannot be shown
// here, a phone refuses to start it from the site's button), the service's
// own player takes over, so the video still plays. When the service cannot
// be reached at all (offline, or blocked by the browser or an extension: its
// API does not load or its player never answers), the still stays, with a
// line and a link to watch the video on the service.

const SERVICES = {
  youtube: { name: "YouTube", api: "https://www.youtube.com/iframe_api" },
  vimeo: { name: "Vimeo", api: "https://player.vimeo.com/api/player.js" },
};

/** "90", "90s", "1m30s", "1h2m3s" â†’ seconds; anything else â†’ 0. */
function seconds(value) {
  const match = /^(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s?)?$/.exec(String(value ?? "").trim());
  if (!match) return 0;
  const [, h = 0, m = 0, s = 0] = match;
  return Number(h) * 3600 + Number(m) * 60 + Number(s);
}

/** A YouTube or Vimeo address â†’ { service, id, hash, start } (hash: a Vimeo
    unlisted video's key; start: seconds), or null for anything else. */
export function onlineVideo(address) {
  let url;
  try {
    url = new URL(String(address).trim());
  } catch {
    return null;
  }
  if (url.protocol !== "https:" && url.protocol !== "http:") return null;
  const host = url.hostname.toLowerCase().replace(/^(?:www|m)\./, "");
  const parts = url.pathname.split("/").filter(Boolean);
  const start = seconds(url.searchParams.get("t") ?? url.searchParams.get("start") ?? /(?:^|&)t=([^&]+)/.exec(url.hash.slice(1))?.[1]);

  const youtube = (id) => (/^[\w-]{11}$/.test(id ?? "") ? { service: "youtube", id, hash: "", start } : null);
  if (host === "youtu.be") return youtube(parts[0]);
  if (host === "youtube.com" || host === "youtube-nocookie.com") {
    if (parts[0] === "watch") return youtube(url.searchParams.get("v"));
    if (["embed", "shorts", "live", "v"].includes(parts[0])) return youtube(parts[1]);
    return null;
  }

  const vimeo = (id, hash) =>
    /^\d+$/.test(id ?? "") ? { service: "vimeo", id, hash: /^[\da-f]+$/i.test(hash ?? "") ? hash : "", start } : null;
  if (host === "player.vimeo.com") return parts[0] === "video" ? vimeo(parts[1], url.searchParams.get("h")) : null;
  if (host === "vimeo.com") {
    // vimeo.com/ID, /ID/HASH, /channels/â€¦/ID, /groups/â€¦/videos/ID, /showcase/â€¦/video/ID
    if (/^\d+$/.test(parts[0] ?? "")) return vimeo(parts[0], parts[1] ?? url.searchParams.get("h"));
    return vimeo(parts.findLast((part) => /^\d+$/.test(part)), url.searchParams.get("h"));
  }
  return null;
}

/** The address of the service's player for a video: hiding the service's
    bar when the site's bar drives it (own), with the service's bar
    otherwise. It takes commands either way (with its own bar it only says
    it is ready) and starts playing as it loads. */
export function playerAddress(video, own, origin = location.origin) {
  if (video.service === "youtube") {
    const query = new URLSearchParams({ autoplay: "1", playsinline: "1", rel: "0", iv_load_policy: "3", enablejsapi: "1" });
    if (origin && origin !== "null") query.set("origin", origin);
    if (own) {
      query.set("controls", "0");
      query.set("disablekb", "1");
    }
    if (video.start) query.set("start", String(video.start));
    return `https://www.youtube-nocookie.com/embed/${video.id}?${query}`;
  }
  const query = new URLSearchParams({ autoplay: "1", playsinline: "1", dnt: "1", title: "0", byline: "0", portrait: "0" });
  if (video.hash) query.set("h", video.hash);
  if (own) query.set("controls", "0");
  return `https://player.vimeo.com/video/${video.id}?${query}${video.start ? `#t=${video.start}s` : ""}`;
}

// The service's player API script, loaded once, on the first tap.
const apis = {};
function loadApi(service) {
  apis[service] ??= new Promise((resolve, reject) => {
    const ready = () => (service === "youtube" ? window.YT?.Player : window.Vimeo?.Player);
    if (service === "youtube" && window.YT?.loaded) return resolve(window.YT);
    if (service === "youtube") {
      const before = window.onYouTubeIframeAPIReady;
      window.onYouTubeIframeAPIReady = () => {
        if (typeof before === "function") before();
        resolve(window.YT);
      };
    }
    const script = document.createElement("script");
    script.src = SERVICES[service].api;
    script.async = true;
    script.onload = () => {
      if (service === "vimeo") ready() ? resolve(window.Vimeo) : reject(new Error("no Vimeo player"));
    };
    script.onerror = () => {
      apis[service] = null; // a later tap may try again
      reject(new Error(`${SERVICES[service].name} player API could not load`));
    };
    document.head.append(script);
  });
  return apis[service];
}

// The service's player, shaped like a <video> for the site's bar. The
// service reports its state through update(); the bar's changes go to it
// through control.
class ServicePlayer extends EventTarget {
  paused = true;
  duration = NaN;
  canChangeSpeed = true;
  control = null;
  closed = false; // after a hand-over the service speaks for itself
  buffering = false; // loading the picture, not refused
  cleanups = []; // the connector's timers, stopped on close
  #time = 0;
  #muted = false;
  #mutedSetAt = -Infinity;
  #rate = 1;

  get currentTime() {
    return this.#time;
  }

  set currentTime(time) {
    this.#time = Math.max(0, Math.min(Number(time) || 0, this.duration || Infinity));
    this.control?.seek(this.#time);
    this.emit("timeupdate");
  }

  get muted() {
    return this.#muted;
  }

  set muted(muted) {
    this.#muted = Boolean(muted);
    this.#mutedSetAt = Date.now();
    this.control?.mute(this.#muted);
    this.emit("volumechange");
  }

  get playbackRate() {
    return this.#rate;
  }

  // The bar shows the speed the service confirms, not the one asked for.
  set playbackRate(rate) {
    if (!this.control) return;
    Promise.resolve(this.control.rate(rate)).then(
      (confirmed) => this.update({ rate: confirmed }),
      () => {
        // Vimeo refuses speed changes on some owners' videos.
        this.canChangeSpeed = false;
        this.emit("ratechange");
      },
    );
  }

  play() {
    if (!this.closed) this.control?.play();
  }

  pause() {
    if (!this.closed) this.control?.pause();
  }

  emit(type) {
    if (!this.closed) this.dispatchEvent(new Event(type));
  }

  close() {
    this.closed = true;
    this.control = null;
    for (const cleanup of this.cleanups.splice(0)) cleanup();
  }

  /** What the service reports; only changes become events. */
  update({ time, duration, paused, muted, rate }) {
    if (this.closed) return;
    if (Number.isFinite(duration) && duration > 0 && duration !== this.duration) {
      this.duration = duration;
      this.emit("durationchange");
    }
    if (Number.isFinite(time) && time !== this.#time) {
      this.#time = time;
      this.emit("timeupdate");
    }
    // The service's own report lags a change made here; trust ours briefly.
    if (typeof muted === "boolean" && muted !== this.#muted && Date.now() - this.#mutedSetAt > 1000) {
      this.#muted = muted;
      this.emit("volumechange");
    }
    if (Number.isFinite(rate) && rate !== this.#rate) {
      this.#rate = rate;
      this.emit("ratechange");
    }
    if (typeof paused === "boolean" && paused !== this.paused) {
      this.paused = paused;
      this.emit(paused ? "pause" : "play");
    }
  }
}

// YouTube's IFrame API on the frame made here. YouTube sends no time
// events, so the time is read four times a second while it plays.
function connectYouTube(YT, frame, player) {
  return new Promise((resolve, reject) => {
    let timer = 0;
    let rateTimer = 0;
    let ready = false;
    let rateWaiter = null;
    player.cleanups.push(() => {
      clearInterval(timer);
      clearTimeout(rateTimer);
    });
    const read = () => {
      if (player.closed) return clearInterval(timer);
      player.update({ time: api.getCurrentTime(), duration: api.getDuration(), muted: api.isMuted() });
    };
    // -1 unstarted, 0 ended, 1 playing, 2 paused, 3 buffering, 5 cued.
    const state = (data) => {
      clearInterval(timer);
      if (player.closed) return;
      player.buffering = data === 3;
      if (data === 1 || data === 3) timer = setInterval(read, 250);
      read();
      if (data === 1) player.update({ paused: false });
      else if (data !== 3) player.update({ paused: true });
      if (data === 0) player.emit("ended");
    };
    // YouTube answers a speed change with an event, or not at all when the
    // video cannot take that speed; then its current speed is the answer.
    const rate = (wanted) =>
      new Promise((answer) => {
        clearTimeout(rateTimer);
        rateTimer = setTimeout(() => answer(api.getPlaybackRate()), 1000);
        rateWaiter = (confirmed) => {
          clearTimeout(rateTimer);
          answer(confirmed);
        };
        api.setPlaybackRate(wanted);
      });
    const api = new YT.Player(frame, {
      events: {
        onReady: () => {
          if (player.closed) return;
          player.control = {
            play: () => api.playVideo(),
            pause: () => api.pauseVideo(),
            seek: (time) => api.seekTo(time, true),
            mute: (muted) => (muted ? api.mute() : api.unMute()),
            rate,
          };
          player.canChangeSpeed = (api.getAvailablePlaybackRates?.() ?? [1, 2]).length > 1;
          player.update({ duration: api.getDuration(), muted: api.isMuted(), rate: api.getPlaybackRate() });
          // It may have started before the API was listening.
          state(api.getPlayerState());
          ready = true;
          resolve({ cc: null });
        },
        onStateChange: ({ data }) => state(data),
        onPlaybackRateChange: ({ data }) => {
          rateWaiter?.(data);
          rateWaiter = null;
          player.update({ rate: data });
        },
        onError: () => {
          clearInterval(timer);
          player.emit("error");
          if (!ready) reject(new Error("YouTube cannot play this video here"));
        },
      },
    });
  });
}

// Vimeo's Player API on the frame made here. Its own captions drive CC.
async function connectVimeo(Vimeo, frame, player) {
  const api = new Vimeo.Player(frame);
  const quiet = (promise) => promise?.catch?.(() => {});
  player.control = {
    // The browser may refuse to start it from the site's button.
    play: () =>
      api.play().catch((error) => {
        if (error?.name === "NotAllowedError") player.emit("refused");
      }),
    pause: () => quiet(api.pause()),
    seek: (time) => quiet(api.setCurrentTime(time)),
    mute: (muted) => quiet(api.setMuted(muted)),
    rate: (rate) => api.setPlaybackRate(rate),
  };
  // What Vimeo's events have reported; the first snapshot below never
  // overwrites these, as it may be older.
  const seen = {};
  const report = (state) => {
    Object.assign(seen, state);
    player.update(state);
  };
  api.on("bufferstart", () => (player.buffering = true));
  api.on("bufferend", () => (player.buffering = false));
  api.on("play", () => report({ paused: false }));
  api.on("pause", () => report({ paused: true }));
  api.on("ended", () => {
    report({ paused: true });
    player.emit("ended");
  });
  api.on("timeupdate", ({ seconds: time, duration }) => report({ time, duration }));
  api.on("durationchange", ({ duration }) => report({ duration }));
  api.on("volumechange", () => quiet(api.getMuted().then((muted) => report({ muted }))));
  api.on("playbackratechange", ({ playbackRate }) => report({ rate: playbackRate }));
  // Errors from a single call carry its method and are handled there.
  api.on("error", (error) => {
    if (!error?.method) player.emit("error");
  });

  await api.ready();
  // It may have started before the listeners above were attached.
  const [duration, muted, tracks, paused, time, rate] = await Promise.all([
    api.getDuration().catch(() => NaN),
    api.getMuted().catch(() => false),
    api.getTextTracks().catch(() => []),
    api.getPaused().catch(() => true),
    api.getCurrentTime().catch(() => 0),
    api.getPlaybackRate().catch(() => 1),
  ]);
  player.update({ ...{ duration, muted, time, rate, paused }, ...seen });
  if (!tracks.length) return { cc: null };
  let on = tracks.some((track) => track.mode === "showing");
  const first = tracks.find((track) => track.kind === "subtitles" || track.kind === "captions") ?? tracks[0];
  return {
    cc: {
      isOn: () => on,
      toggle: () => quiet(on ? api.disableTextTrack() : api.enableTextTrack(first.language, first.kind)),
      watch: (callback) =>
        api.on("texttrackchange", ({ language }) => {
          on = Boolean(language);
          callback();
        }),
    },
  };
}

const done = new WeakSet();

/** promise, or a refusal when it has not settled within 10 s. */
function within10s(promise) {
  let timer = 0;
  const late = new Promise((_, reject) => {
    timer = setTimeout(() => reject(new Error("the player did not answer")), 10000);
  });
  return Promise.race([promise, late]).finally(() => clearTimeout(timer));
}

function setUp(link, video, kit) {
  const service = SERVICES[video.service];
  const own = link.dataset.controls !== "service";
  const still = link.querySelector("img");
  const name = kit.nameOf(link) || still?.alt.trim() || "";
  const watch = link.href;
  const box = kit.wrap(link, "online");
  if (link.id) box.id = link.id; // links to #the-video keep working
  box.dataset.service = video.service;
  box.setAttribute("role", "group");
  box.setAttribute("aria-label", name ? `Video: ${name}` : "Video");
  const start = kit.startButton(name);
  start.setAttribute("aria-label", `${start.getAttribute("aria-label")} (plays from ${service.name})`);
  if (still) link.replaceWith(still);
  else link.remove();
  box.append(start);

  let player = null;
  let frame = null;
  let surface = null;
  let bar = null;

  // The service's own player takes over: its bar, its messages.
  const handOver = (address) => {
    player?.close();
    box.dataset.state = "service";
    start.hidden = true;
    bar?.remove();
    frame.removeAttribute("tabindex");
    frame.removeAttribute("aria-hidden");
    if (address && frame.src !== address) frame.src = address;
  };

  // The service cannot be reached: no frame, the still and a link instead
  // of an empty white box.
  const blocked = () => {
    player?.close();
    const hadFocus = box.contains(document.activeElement);
    for (const part of [frame, surface, bar, start]) part?.remove();
    box.dataset.state = "blocked";
    const note = document.createElement("p");
    note.className = "media-blocked";
    const away = Object.assign(document.createElement("a"), { href: watch, textContent: `Watch on ${service.name}` });
    note.append("This video can't play here. ", away);
    box.append(note);
    if (hadFocus) away.focus();
  };

  const begin = async () => {
    if (navigator.onLine === false) return blocked();
    box.dataset.state = "loading";
    start.setAttribute("aria-busy", "true");
    frame = document.createElement("iframe");
    frame.className = "media-frame";
    frame.src = playerAddress(video, own);
    frame.title = name ? `${name} (${service.name})` : `${service.name} video`;
    frame.allow = "autoplay; fullscreen; picture-in-picture; encrypted-media";
    // YouTube refuses embeds that send no referrer.
    frame.referrerPolicy = "strict-origin-when-cross-origin";
    start.before(frame);
    if (!own) {
      handOver();
      // Its own bar needs no API; the player's ready answer through it
      // tells that the service could be reached.
      const ready = (lib) =>
        video.service === "vimeo"
          ? new lib.Player(frame).ready()
          : new Promise((answer) => new lib.Player(frame, { events: { onReady: answer } }));
      within10s(loadApi(video.service).then(ready)).catch(() => {
        if (box.dataset.state === "service") blocked();
      });
      return;
    }
    // The site's bar is the way to control it; the frame is only the picture.
    frame.tabIndex = -1;
    frame.setAttribute("aria-hidden", "true");
    surface = document.createElement("div");
    surface.className = "media-surface";
    start.before(surface);

    player = new ServicePlayer();
    // With the service's own controls back, its message and buttons work.
    const serviceAddress = playerAddress(video, false);
    player.addEventListener("error", () => handOver(serviceAddress));
    let parts;
    try {
      // Never stays loading: after 10 s without an answer it counts as blocked.
      parts = await within10s(
        loadApi(video.service).then((lib) => {
          if (player.closed) throw new Error("handed over meanwhile");
          return (video.service === "youtube" ? connectYouTube : connectVimeo)(lib, frame, player);
        }),
      );
    } catch {
      // An error already handed over; otherwise the API did not load or answer.
      if (box.dataset.state !== "service") blocked();
      return;
    }
    if (box.dataset.state === "service") return; // an error came first
    bar = kit.videoBar(box, player, { start, surface, cc: parts.cc });
    start.removeAttribute("aria-busy");
    box.dataset.state = "ready";
    // At the end the still comes back, covering the service's suggestions.
    player.addEventListener("ended", () => {
      delete box.dataset.started;
      start.hidden = false;
      bar.hidden = true;
    });
    // The bar started listening after the service did: catch up.
    if (!player.paused) player.emit("play");
    else player.play();
    // A phone may refuse to start the service from the site's button; then
    // the service's own player, with its play button, takes over: at once
    // when the service says so, else when it has not started after 4 s and
    // is not still loading (16 s at most).
    player.addEventListener("refused", () => handOver(serviceAddress));
    let waited = 4000;
    let refusal = 0;
    const check = () => {
      if ("started" in box.dataset || box.dataset.state !== "ready") return;
      if (player.buffering && waited < 16000) {
        waited += 2000;
        refusal = setTimeout(check, 2000);
      } else {
        handOver(serviceAddress);
      }
    };
    refusal = setTimeout(check, waited);
    player.cleanups.push(() => clearTimeout(refusal));
  };

  start.addEventListener("click", () => {
    if (!frame) begin();
    else kit.play(player);
  });
}

/** Turns each a.online-video under root into a still with the site's play
    button that loads the service on tap. kit: the player's shared parts. */
export function enhanceOnline(root, kit) {
  for (const link of root.querySelectorAll("a.online-video")) {
    if (done.has(link) || link.closest(".media-player")) continue;
    const video = onlineVideo(link.href);
    if (!video) continue; // not YouTube or Vimeo: it stays a link
    done.add(link);
    setUp(link, video, kit);
  }
}
// The site's media player: one small, dependency-free ES module. Pages that
// hold a video or a sound clip load it with the player's stylesheet:
//
//   <link rel="stylesheet" href="/styles/media-player.css">
//   <script type="module" src="/scripts/media-player.js"></script>
//
// It turns the plain markup below into players in the site's colours and
// fonts. Without it (no JavaScript, an old browser, a failed load) the
// markup still works: the browser shows its own controls.
//
// Video, still picture until tapped; loads and plays with sound on tap:
//   <video src="/media/clip.mp4" poster="/media/clip.webp" controls
//          preload="none" playsinline width="1280" height="720">
//     <track kind="subtitles" src="/media/clip.vtt" srclang="en" label="English">
//   </video>
// The bar: play/pause, timeline, time, sound on/off, CC (when a subtitles or
// captions track is there), speed, picture-in-picture and full screen.
//
// Looping video, silent, plays by itself while on screen, with one small
// round pause/play button in a corner; starts paused when the visitor's
// device asks for less motion:
//   <video src="/media/loop.mp4" poster="/media/loop.webp" controls muted loop playsinline></video>
// Leave out autoplay: the player starts it, so without JavaScript a visitor
// who asked for less motion still sees the still picture and the browser's
// play button. (autoplay works too; the player pauses it for less motion.)
// Inside a link, leave out controls (a video with controls is not allowed
// there): <a href="/story/"><video src=â€¦ muted loop playsinline></video></a>.
// The corner button pauses and plays without following the link; the rest
// of the picture still opens it.
//
// Background video, the first child of a section that it fills; no controls.
// Shows its still for less motion or when the browser asks to save data:
//   <section><video data-background src="/media/bg.mp4" poster="/media/bg.webp"
//          muted loop playsinline preload="none"></video> â€¦the sectionâ€¦ </section>
//
// Audio, play/pause, timeline and elapsed/total time; a Transcript button
// under it when a subtitles track is there. data-duration (seconds) shows the
// total time before the file loads:
//   <audio src="/media/talk.m4a" controls preload="none" data-duration="754">
//     <track kind="subtitles" src="/media/talk.vtt" srclang="en" label="English">
//   </audio>
//
// Subtitles tracks are WebVTT (.vtt); browsers read no other kind.
// Name a video or clip with aria-label (or title): the players use it.
// data-player="off" on a <video> or <audio> leaves it to the browser.
// A video or looping video gets a <div class="media-player"> wrapper; a slot
// attribute moves to the wrapper, so it stays in its component's slot. So
// component CSS styles a media slot by its name ([slot="image"]), which
// matches the wrapper; the video fills it and keeps its own object-position.
// Download cards (styles/media-player.css) need no script.
//
// Online video, a YouTube or Vimeo video: a link to it holding its still
// picture, copied into the site. Visitors see the still with a play button;
// YouTube (from youtube-nocookie.com) or Vimeo loads only on tap, then the
// bar above is laid over it (scripts/media-online.js, loaded only by pages
// that have one). Without the script the link opens the video on its site:
//   <a class="online-video" href="https://www.youtube.com/watch?v=aqz-KE-bpKQ">
//     <img src="/media/talk.webp" alt="Big Buck Bunny" width="1280" height="720">
//   </a>
// The href may be any usual YouTube or Vimeo address (watch, youtu.be,
// embed, shorts, vimeo.com/ID or /ID/HASH, player.vimeo.com); a start time
// (t=90, t=1m30s, #t=90s) is kept. If the service cannot be reached (offline,
// or blocked by the browser), the still stays with a link to watch it there.
// data-controls="service" keeps the service's own bar: use it for a Vimeo
// video whose owner's plan cannot hide Vimeo's bar. The still's alt (or the
// link's aria-label) names the video.

const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");
const enhanced = new WeakSet();
const players = new Set(); // ordinary videos and audio: one plays at a time

const ICONS = {
  play: "M8 5.5v13l10.5-6.5z",
  pause: "M7 5h3.5v14H7zM13.5 5H17v14h-3.5z",
  sound: "M4 9h4l5-4v14l-5-4H4zM16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12",
  muted: "M4 9h4l5-4v14l-5-4H4zM16 9.5l5 5M21 9.5l-5 5",
  cc: "M3 6h18v12H3zM10.5 10.2a2.4 2.4 0 1 0 0 3.6M17 10.2a2.4 2.4 0 1 0 0 3.6",
  pip: "M3 5h18v14H3zM12 12h7v5h-7z",
  full: "M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5",
  exit: "M9 4v5H4M20 9h-5V4M15 20v-5h5M4 15h5v5",
};

function icon(name) {
  const filled = name === "play" || name === "pause";
  return `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="${ICONS[name]}"${
    filled ? "" : ' fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"'
  }/></svg>`;
}

function button(className, label, iconName) {
  const el = document.createElement("button");
  el.type = "button";
  el.className = className;
  el.setAttribute("aria-label", label);
  if (iconName) el.innerHTML = icon(iconName);
  return el;
}

function setIcon(el, name) {
  if (el.dataset.icon !== name) {
    el.dataset.icon = name;
    el.innerHTML = icon(name);
  }
}

/** 75.4 â†’ "1:15"; 3725 â†’ "1:02:05"; anything unknown â†’ "--:--". */
export function formatTime(seconds) {
  if (!Number.isFinite(seconds) || seconds < 0) return "--:--";
  const s = Math.floor(seconds);
  const h = Math.floor(s / 3600);
  const m = Math.floor((s % 3600) / 60);
  const ss = String(s % 60).padStart(2, "0");
  return h ? `${h}:${String(m).padStart(2, "0")}:${ss}` : `${m}:${ss}`;
}

const ENTITIES = { amp: "&", lt: "<", gt: ">", quot: '"', apos: "'", nbsp: " ", lrm: "", rlm: "" };

/** The spoken text of a WebVTT (or SRT) file, one string per cue, without
    timings, tags or repeats: what the Transcript shows. */
export function cueText(source) {
  const out = [];
  for (const block of String(source).replace(/\r\n?/g, "\n").split(/\n\s*\n/)) {
    const rows = block.split("\n");
    const at = rows.findIndex((row) => row.includes("-->"));
    if (at < 0) continue; // the WEBVTT header, NOTE, STYLE and REGION blocks
    const text = rows
      .slice(at + 1)
      .join(" ")
      .replace(/<v(?:\.[^ >]*)? ([^>]+)>/g, "$1: ")
      .replace(/<[^>]*>/g, "")
      .replace(/&(#\d+|[a-z]+);/gi, (all, name) =>
        name[0] === "#" ? String.fromCodePoint(Number(name.slice(1))) : (ENTITIES[name.toLowerCase()] ?? all))
      .replace(/\s+/g, " ")
      .trim();
    if (text && text !== out[out.length - 1]) out.push(text);
  }
  return out;
}

function nameOf(media) {
  return (media.getAttribute("aria-label") || media.title || "").trim();
}

// The wrapper the controls sit in. It takes over the media's slot, so a
// video slotted into a component stays in that slot.
function wrap(media, kind) {
  const box = document.createElement("div");
  box.className = "media-player";
  box.dataset.kind = kind;
  const slot = media.getAttribute("slot");
  if (slot !== null) {
    box.setAttribute("slot", slot);
    media.removeAttribute("slot");
  }
  media.before(box);
  box.append(media);
  return box;
}

function play(media) {
  const result = media.play();
  if (result) result.catch(() => {});
}

// Timeline and time: a range input (arrow keys and screen readers work as
// for any slider) between the elapsed and total time.
function timeline(media) {
  const elapsed = document.createElement("span");
  const total = document.createElement("span");
  elapsed.className = "media-time";
  total.className = "media-time";
  const range = document.createElement("input");
  range.type = "range";
  range.className = "media-timeline";
  range.min = "0";
  range.step = "any";
  range.value = "0";
  range.setAttribute("aria-label", "Seek");
  let dragging = false;
  const duration = () =>
    Number.isFinite(media.duration) && media.duration > 0 ? media.duration : Number(media.dataset?.duration) || 0;
  const sync = () => {
    const d = duration();
    const now = dragging ? Number(range.value) : media.currentTime;
    range.max = String(d || 1);
    range.disabled = !d;
    if (!dragging) range.value = String(now);
    range.style.setProperty("--media-progress", `${d ? Math.min(100, (now / d) * 100) : 0}%`);
    range.setAttribute("aria-valuetext", `${formatTime(now)} of ${d ? formatTime(d) : "unknown"}`);
    elapsed.textContent = formatTime(now);
    total.textContent = d ? formatTime(d) : "--:--";
  };
  range.addEventListener("input", () => {
    dragging = true;
    media.currentTime = Number(range.value);
    sync();
  });
  range.addEventListener("change", () => {
    dragging = false;
    sync();
  });
  for (const type of ["timeupdate", "durationchange", "loadedmetadata", "seeked", "emptied"]) {
    media.addEventListener(type, sync);
  }
  sync();
  return [elapsed, range, total];
}

function playToggle(media, className) {
  const toggle = button(className, "Play", "play");
  const sync = () => {
    toggle.setAttribute("aria-label", media.paused ? "Play" : "Pause");
    setIcon(toggle, media.paused ? "play" : "pause");
  };
  toggle.addEventListener("click", () => (media.paused ? play(media) : media.pause()));
  media.addEventListener("play", sync);
  media.addEventListener("pause", sync);
  sync();
  return toggle;
}

// One ordinary player at a time: starting one pauses the others.
function joinPlayers(media) {
  players.add(media);
  media.addEventListener("play", () => {
    for (const other of players) if (other !== media && !other.paused) other.pause();
  });
}

// If the browser cannot play the file, hand it back to the browser's own
// controls so the visitor sees what the browser says.
function fallBack(media, box, parts) {
  media.addEventListener("error", () => {
    for (const part of parts) part.remove();
    delete box.dataset.started;
    media.controls = true;
  });
}

// The still's large play button, shared with Online videos.
function startButton(name) {
  const start = button("media-start", name ? `Play video: ${name}` : "Play video");
  start.innerHTML = `<span class="media-start-disc">${icon("play")}</span>`;
  return start;
}

// CC for a video's own subtitles or captions track.
function trackSwitch(video) {
  const trackEl = video.querySelector('track[kind="subtitles"], track[kind="captions"]');
  const track = trackEl?.track;
  if (!track) return null;
  track.mode = trackEl.default ? "showing" : "disabled";
  return {
    isOn: () => track.mode === "showing",
    toggle: () => {
      track.mode = track.mode === "showing" ? "disabled" : "showing";
    },
    // The browser's own full screen (an iPhone) can switch subtitles too.
    watch: (callback) => video.textTracks.addEventListener?.("change", callback),
  };
}

// Picture-in-picture where the browser has it (Safari's presentation mode too).
function pipSwitch(video) {
  const webkitPip =
    typeof video.webkitSetPresentationMode === "function" &&
    typeof video.webkitSupportsPresentationMode === "function" &&
    video.webkitSupportsPresentationMode("picture-in-picture");
  if (!((document.pictureInPictureEnabled && !video.disablePictureInPicture) || webkitPip)) return null;
  const isOn = () =>
    document.pictureInPictureElement === video || video.webkitPresentationMode === "picture-in-picture";
  return {
    isOn,
    toggle: () => {
      if (document.pictureInPictureEnabled) {
        const done = isOn() ? document.exitPictureInPicture() : video.requestPictureInPicture();
        done.catch(() => {});
      } else {
        video.webkitSetPresentationMode(isOn() ? "inline" : "picture-in-picture");
      }
    },
    watch: (callback) => {
      for (const type of ["enterpictureinpicture", "leavepictureinpicture", "webkitpresentationmodechanged"]) {
        video.addEventListener(type, callback);
      }
    },
  };
}

// Subtitles clear the bar while it shows and drop back when it hides. The
// browser draws them in lines of about 5% of the picture's smaller side,
// counted up from the bottom, and a cue's first line sits on its line
// number, so a cue goes up by the bar's height plus its own lines (its line
// breaks, and a guess at wrapping that errs high); with the bar hidden, just
// its own lines, which is where the browser puts it by itself. Chrome
// redraws a cue on screen only when it is added again, so a moved one is.
// A cue the subtitles file places itself keeps its own line.
function liftSubtitles(box, video, bar) {
  const trackEl = video.querySelector('track[kind="subtitles"], track[kind="captions"]');
  const track = trackEl?.track;
  if (!track) return;
  const ours = new WeakSet();
  const place = () => {
    const picture = video.getBoundingClientRect();
    const font = Math.min(picture.width, picture.height) * 0.05;
    if (!font) return; // not laid out yet
    const shows = bar.isConnected && !bar.hidden && !("idle" in box.dataset) && !video.webkitDisplayingFullscreen;
    const lift = shows ? Math.max(0, Math.ceil((picture.bottom - bar.getBoundingClientRect().top) / font)) : 0;
    const fits = picture.width / (0.6 * font); // a low guess at the characters a line holds
    const onScreen = new Set(track.activeCues ?? []);
    for (const cue of [...(track.cues ?? [])]) {
      if (cue.line === "auto") ours.add(cue);
      const rows = cue.text.replace(/<[^>]*>/g, "").split("\n").reduce((n, row) => n + Math.max(1, Math.ceil(row.length / fits)), 0);
      if (!ours.has(cue) || cue.line === -lift - rows) continue;
      cue.line = -lift - rows;
      if (onScreen.has(cue)) {
        track.removeCue(cue);
        track.addCue(cue);
      }
    }
  };
  const watch = { attributes: true, attributeFilter: ["hidden", "data-idle", "data-started", "data-narrow"] };
  const changes = new MutationObserver(place);
  changes.observe(box, watch);
  changes.observe(bar, watch);
  if (typeof ResizeObserver === "function") new ResizeObserver(place).observe(box);
  trackEl.addEventListener("load", place);
  for (const type of ["webkitbeginfullscreen", "webkitendfullscreen"]) video.addEventListener(type, place);
}

/** The bar of a video, shared by the site's own videos and Online videos
    (enhance() hands it to scripts/media-online.js). media is a <video> or
    an object shaped like one: paused, currentTime, duration, muted,
    playbackRate, play(), pause() and the same events; canChangeSpeed false
    hides the speed button.
    Optional parts:
      start       the still's play button: on first play it hides, the bar shows
      surface     the picture: a click plays or pauses, a double click goes full screen
      cc, pip     { isOn(), toggle(), watch(callback) }, when the video has them
      nativeFull  full screen where the wrapper cannot go full screen (an iPhone)
    Returns the bar. */
function videoBar(box, media, { start, surface, cc, pip, nativeFull } = {}) {
  const bar = document.createElement("div");
  bar.className = "media-bar";
  bar.hidden = true;
  const toggle = playToggle(media, "media-toggle");
  bar.append(toggle, ...timeline(media));

  const mute = button("media-mute", "Mute");
  const syncMute = () => {
    mute.setAttribute("aria-pressed", String(media.muted));
    setIcon(mute, media.muted ? "muted" : "sound");
  };
  mute.addEventListener("click", () => {
    media.muted = !media.muted;
    syncMute();
  });
  media.addEventListener("volumechange", syncMute);
  syncMute();
  bar.append(mute);

  let ccButton = null;
  if (cc) {
    ccButton = button("media-cc", "Subtitles", "cc");
    const syncCc = () => ccButton.setAttribute("aria-pressed", String(cc.isOn()));
    ccButton.addEventListener("click", () => {
      cc.toggle();
      syncCc();
    });
    cc.watch(syncCc);
    syncCc();
    bar.append(ccButton);
  }

  const speeds = [1, 1.25, 1.5, 2, 0.75];
  const speed = button("media-speed", "Speed 1Ã—");
  const syncSpeed = () => {
    speed.textContent = `${media.playbackRate}Ã—`;
    speed.setAttribute("aria-label", `Speed ${media.playbackRate}Ã—`);
    speed.hidden = media.canChangeSpeed === false;
  };
  speed.addEventListener("click", () => {
    const at = speeds.indexOf(media.playbackRate);
    media.playbackRate = speeds[(at + 1) % speeds.length];
    syncSpeed();
  });
  media.addEventListener("ratechange", syncSpeed);
  syncSpeed();
  bar.append(speed);

  if (pip) {
    const pipButton = button("media-pip", "Picture in picture", "pip");
    const syncPip = () => pipButton.setAttribute("aria-pressed", String(pip.isOn()));
    pipButton.addEventListener("click", () => pip.toggle());
    pip.watch(syncPip);
    syncPip();
    bar.append(pipButton);
  }

  // Full screen: the wrapper, so the bar comes along; an iPhone has only the
  // video's own full screen, with the system's controls.
  const elementFull = (document.fullscreenEnabled || document.webkitFullscreenEnabled) &&
    (box.requestFullscreen || box.webkitRequestFullscreen);
  let full = null;
  if (elementFull || nativeFull) {
    full = button("media-full", "Full screen", "full");
    const isFull = () => (document.fullscreenElement || document.webkitFullscreenElement) === box;
    const syncFull = () => {
      full.setAttribute("aria-pressed", String(isFull()));
      setIcon(full, isFull() ? "exit" : "full");
    };
    full.addEventListener("click", () => {
      if (isFull()) {
        (document.exitFullscreen || document.webkitExitFullscreen).call(document);
      } else if (elementFull) {
        const done = (box.requestFullscreen || box.webkitRequestFullscreen).call(box);
        if (done) done.catch(() => {});
      } else {
        nativeFull();
      }
    });
    document.addEventListener("fullscreenchange", syncFull);
    document.addEventListener("webkitfullscreenchange", syncFull);
    syncFull();
    bar.append(full);
    surface?.addEventListener("dblclick", () => full.click());
  }

  box.append(bar);
  joinPlayers(media);

  media.addEventListener("play", () => {
    if ("started" in box.dataset) return;
    const hadFocus = document.activeElement === start;
    box.dataset.started = "";
    if (start) start.hidden = true;
    bar.hidden = false;
    if (hadFocus) toggle.focus();
  });

  // The bar hides while the video plays and nobody moves, then comes back.
  let idleTimer = 0;
  const wake = () => {
    delete box.dataset.idle;
    clearTimeout(idleTimer);
    idleTimer = setTimeout(() => {
      if (!media.paused && !box.contains(document.activeElement) && !bar.matches(":hover")) {
        box.dataset.idle = "";
      }
    }, 2500);
  };
  box.addEventListener("pointermove", wake);
  box.addEventListener("focusin", wake);
  media.addEventListener("pause", wake);
  media.addEventListener("play", wake);

  // A tap on the picture shows the bar if it was hidden; otherwise a click
  // plays or pauses.
  let wasIdle = false;
  surface?.addEventListener("pointerdown", (event) => {
    wasIdle = event.pointerType !== "mouse" && "idle" in box.dataset;
  });
  surface?.addEventListener("click", () => {
    if (!("started" in box.dataset)) return;
    if (wasIdle) wake();
    else if (media.paused) play(media);
    else media.pause();
  });

  // Keys while focus is in the player: k play/pause, m sound, c subtitles,
  // f full screen, arrows jump five seconds (the timeline's own arrows step).
  box.addEventListener("keydown", (event) => {
    if (event.altKey || event.ctrlKey || event.metaKey || !("started" in box.dataset)) return;
    const onRange = event.target.matches?.(".media-timeline");
    const key = event.key.toLowerCase();
    const press = (el) => el && (el.click(), true);
    let handled = false;
    if (key === "k" || (key === " " && onRange)) handled = press(toggle);
    else if (key === "m") handled = press(mute);
    else if (key === "c") handled = press(ccButton);
    else if (key === "f") handled = press(full);
    else if (!onRange && (key === "arrowleft" || key === "arrowright")) {
      media.currentTime = Math.max(0, media.currentTime + (key === "arrowleft" ? -5 : 5));
      handled = true;
    }
    if (handled) event.preventDefault();
  });

  if (typeof ResizeObserver === "function") {
    new ResizeObserver(([entry]) => {
      box.toggleAttribute("data-narrow", entry.contentRect.width < 480);
    }).observe(box);
  }
  return bar;
}

function enhanceVideo(video) {
  const box = wrap(video, "video");
  video.controls = false;
  video.playsInline = true;
  const name = nameOf(video);
  box.setAttribute("role", "group");
  box.setAttribute("aria-label", name ? `Video: ${name}` : "Video");
  const start = startButton(name);
  box.append(start);
  const bar = videoBar(box, video, {
    start,
    surface: video,
    cc: trackSwitch(video),
    pip: pipSwitch(video),
    nativeFull: typeof video.webkitEnterFullscreen === "function" ? () => video.webkitEnterFullscreen() : null,
  });
  fallBack(video, box, [start, bar]);
  liftSubtitles(box, video, bar);

  // Tapping the still starts the video: it loads only now.
  start.addEventListener("click", () => {
    video.preload = "auto";
    play(video);
  });
}

function enhanceLooping(video) {
  const background = video.hasAttribute("data-background");
  const autoplay = video.autoplay;
  video.muted = true;
  video.loop = true;
  video.playsInline = true;
  video.autoplay = false;
  video.controls = false;
  const corner = button("media-corner", "Pause video", "pause");
  let box = null;
  if (background) {
    video.after(corner);
  } else {
    box = wrap(video, "loop");
    box.append(corner);
    // Inside a link, the link is named from its content: a named group gives
    // it the video's name (or "Looping video" for an unnamed one) instead of
    // the corner button's changing "Pause video".
    if (box.closest("a[href]")) {
      box.setAttribute("role", "group");
      box.setAttribute("aria-label", nameOf(video) || "Looping video");
    }
  }

  const calm = () => reduceMotion.matches || (background && navigator.connection?.saveData === true);
  let wanted = !calm(); // the visitor's choice; the corner button changes it
  let onScreen = false;
  const apply = () => (wanted && onScreen ? play(video) : video.pause());
  if (!wanted && autoplay) video.pause();

  const sync = () => {
    corner.setAttribute("aria-label", video.paused ? "Play video" : "Pause video");
    setIcon(corner, video.paused ? "play" : "pause");
  };
  video.addEventListener("play", sync);
  video.addEventListener("pause", sync);
  sync();
  // The corner may sit inside a link (a looping video made from a linked GIF)
  // or a clickable card: pressing it pauses or plays, and nothing else; a
  // middle click on it opens no tab. The rest of the link still follows it.
  const own = (event) => {
    event.preventDefault();
    event.stopPropagation();
  };
  corner.addEventListener("auxclick", own);
  corner.addEventListener("click", (event) => {
    own(event);
    wanted = video.paused;
    if (wanted) video.preload = "auto";
    if (wanted) play(video);
    else video.pause();
  });
  reduceMotion.addEventListener?.("change", () => {
    if (reduceMotion.matches) {
      wanted = false;
      apply();
    }
  });

  // Play only while on screen, which also spares the battery.
  if (typeof IntersectionObserver === "function") {
    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      apply();
    }).observe(video);
  } else {
    onScreen = true;
    apply();
  }

  video.addEventListener("error", () => {
    corner.remove();
    if (!background) video.controls = true;
  });
}

function enhanceAudio(audio) {
  const box = wrap(audio, "audio");
  audio.controls = false;
  const name = nameOf(audio);
  box.setAttribute("role", "group");
  box.setAttribute("aria-label", name ? `Audio: ${name}` : "Audio");
  const bar = document.createElement("div");
  bar.className = "media-bar";
  bar.append(playToggle(audio, "media-toggle"), ...timeline(audio));
  box.append(bar);
  const parts = [bar];

  const trackEl = audio.querySelector('track[kind="subtitles"], track[kind="captions"]');
  if (trackEl && trackEl.getAttribute("src")) {
    const panel = document.createElement("div");
    panel.className = "media-transcript";
    panel.id = `media-transcript-${Math.random().toString(36).slice(2, 9)}`;
    panel.hidden = true;
    // A long transcript scrolls inside the panel, so keyboard users can focus it.
    panel.tabIndex = 0;
    panel.setAttribute("role", "region");
    panel.setAttribute("aria-label", name ? `Transcript: ${name}` : "Transcript");
    const open = document.createElement("button");
    open.type = "button";
    open.className = "media-transcript-toggle";
    open.textContent = "Transcript";
    open.setAttribute("aria-expanded", "false");
    open.setAttribute("aria-controls", panel.id);
    let loaded = false;
    open.addEventListener("click", async () => {
      const show = panel.hidden;
      panel.hidden = !show;
      open.setAttribute("aria-expanded", String(show));
      if (!show || loaded) return;
      loaded = true;
      panel.textContent = "Loadingâ€¦";
      try {
        const response = await fetch(trackEl.src);
        if (!response.ok) throw new Error(String(response.status));
        const lines = cueText(await response.text());
        panel.replaceChildren(
          ...lines.map((line) => Object.assign(document.createElement("p"), { textContent: line })),
        );
      } catch {
        loaded = false;
        const link = Object.assign(document.createElement("a"), { href: trackEl.src, textContent: "Open the transcript file" });
        panel.replaceChildren("The transcript could not be loaded. ", link);
      }
    });
    box.append(open, panel);
    parts.push(open, panel);
  }

  joinPlayers(audio);
  fallBack(audio, box, parts);
}

/** Turns every video and audio element under root into a player, and each
    Online video into a still with a play button. Safe to call again for
    media added later; each element is done once. */
export function enhance(root = document) {
  if (root.querySelector("a.online-video")) {
    import("./media-online.js").then(
      (online) => online.enhanceOnline(root, { wrap, nameOf, play, startButton, videoBar }),
      () => {}, // without the layer the link still opens the video on its site
    );
  }
  for (const media of root.querySelectorAll("video, audio")) {
    if (enhanced.has(media) || media.dataset.player === "off") continue;
    const looping = media.localName === "video" && (media.hasAttribute("data-background") || (media.hasAttribute("loop") && media.hasAttribute("muted")));
    if (!looping && !media.hasAttribute("controls")) continue;
    enhanced.add(media);
    if (looping) enhanceLooping(media);
    else if (media.localName === "video") enhanceVideo(media);
    else enhanceAudio(media);
  }
}

enhance();
@layer elements {
  /* A link to a part of a page (/#work, /about/#contact) scrolls it clear of
     the sticky header. */
  html {
    scroll-padding-top: var(--space-5xl);
  }

  body {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-m);
    line-height: 1.5;
    color: var(--ink);
    background: var(--page);
  }

  /* No margins on elements: spacing comes from the container (.flow, or gap
     in a component). Not on an element a page slots into a component: a page
     rule there beats the component's ::slotted() rules, so the component sets
     its parts' margins (a page rule that names a part still can). */
  :is(h1, h2, h3, h4, h5, h6, p, ul, ol, dl, dd, figure, blockquote, pre, address):not([slot]) {
    margin: 0;
  }

  /* Not on a heading a page slots into a component: the component sizes it,
     and a page rule would win over the ::slotted() twin components.js gives
     the component's rule. */
  h1:not([slot]) {
    font-size: var(--text-4xl);
    line-height: 1.15;
  }

  h2:not([slot]) {
    font-size: var(--text-2xl);
  }

  /* Links in running text. Buttons and navigation set their own colour. */
  p a,
  li a {
    color: var(--accent);
  }

  /* A whole-title link keeps the title's look, even inside a list item. */
  :is(h1, h2, h3, h4, h5, h6, [slot="title"]) > a:only-child {
    color: inherit;
    text-decoration: none;
  }

  :is(h1, h2, h3, h4, h5, h6, [slot="title"]) > a:only-child:hover {
    text-decoration: underline;
  }

  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: var(--radius-s);
  }
}
@layer layout {
  .page {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-3xl) var(--space-l) var(--space-5xl);
  }

  /* Space between the page's sections. */
  .page > * + * {
    margin-top: var(--space-4xl);
  }

  /* Rhythm inside a block of text: each child sits a step below the one
     before it, a little further after a heading. */
  .flow > * + * {
    margin-top: var(--space-s);
  }

  .flow > h2 + * {
    margin-top: var(--space-m);
  }

  .flow > p {
    max-width: var(--reading-width);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-m);
  }

  /* Stretch a title link over its card. This lives in the site's CSS because
     component CSS cannot reach a link inside slotted content. The second
     selector reaches cards in a section component's items slot (their host is
     a child of the section's tag); a section component's own title, whose
     host sits in main, body, a section or a div, keeps a title-sized link. */
  .cards > * {
    position: relative;
  }

  .cards > * :is(h2, h3, h4, [slot="title"]) > a:only-child::after,
  :not(main, body, section, div) > * > [slot="title"] > a:only-child::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  /* Keep other links above the stretched title link: in a .cards item, */
  .cards > * a:not(:is(h2, h3, h4, [slot="title"]) > a:only-child) {
    position: relative;
    z-index: 1;
  }

  /* and in a card in an items slot (its own rule, so a browser without
     :has() still keeps the one above). */
  :not(main, body, section, div) > :has(> [slot="title"] > a:only-child) a:not([slot="title"] > a:only-child) {
    position: relative;
    z-index: 1;
  }
}
/* The media player's look (scripts/media-player.js builds the players) and
   the download cards. Linked on pages that hold media, after site.css:
     <link rel="stylesheet" href="/styles/media-player.css">
   Everything takes the site's colour roles, fonts, space and shapes from
   tokens.css, so the players follow --brand, the visitor's light or dark
   setting and the band's data-tone. Its layer comes after the shared ones;
   a page's own unlayered CSS still wins. */
@layer media-player {
  .media-player {
    position: relative;
    color: var(--ink);
    font-family: var(--font-body);
  }

  .media-player [hidden] {
    display: none;
  }

  .media-player > video {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Buttons: round, the icon in the text colour. */
  .media-player button {
    display: inline-grid;
    place-items: center;
    flex: none;
    min-width: 36px;
    height: 36px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: var(--radius-full);
    background: none;
    color: inherit;
    font: 600 var(--text-s) / 1 var(--font-body);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .media-player button:hover {
    background: color-mix(in srgb, currentColor 12%, transparent);
  }

  .media-player button svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .media-player button[aria-pressed="true"]:not(.media-mute) {
    background: color-mix(in srgb, currentColor 16%, transparent);
  }

  .media-player :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Play/pause: the accent fill, like the site's buttons. */
  .media-player .media-toggle {
    background: var(--accent);
    color: var(--on-accent);
  }

  .media-player .media-toggle:hover {
    background: var(--accent);
    filter: brightness(0.92);
  }

  .media-bar {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
  }

  .media-time {
    min-width: 4ch;
    padding-inline: var(--space-3xs);
    font-size: var(--text-s);
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  /* The timeline: an accent fill over a soft track, an accent knob. */
  .media-timeline {
    --media-track: color-mix(in srgb, currentColor 22%, transparent);
    flex: 1;
    min-width: 48px;
    height: 24px;
    margin: 0;
    background: transparent;
    cursor: pointer;
    appearance: none;
  }

  .media-timeline:disabled {
    cursor: default;
    opacity: 0.6;
  }

  .media-timeline::-webkit-slider-runnable-track {
    height: 4px;
    border-radius: 2px;
    background:
      linear-gradient(var(--accent) 0 0) 0 / var(--media-progress, 0%) 100% no-repeat,
      var(--media-track);
  }

  .media-timeline::-webkit-slider-thumb {
    width: 14px;
    height: 14px;
    margin-top: -5px;
    border: 2px solid var(--surface);
    border-radius: 50%;
    background: var(--accent);
    appearance: none;
  }

  .media-timeline::-moz-range-track {
    height: 4px;
    border-radius: 2px;
    background: var(--media-track);
  }

  .media-timeline::-moz-range-progress {
    height: 4px;
    border-radius: 2px;
    background: var(--accent);
  }

  .media-timeline::-moz-range-thumb {
    width: 10px;
    height: 10px;
    border: 2px solid var(--surface);
    border-radius: 50%;
    background: var(--accent);
  }

  .media-timeline:focus-visible {
    border-radius: var(--radius-s);
  }

  /* Video: the still with a large play button over it, until it starts. */
  .media-start {
    position: absolute;
    inset: 0;
  }

  .media-player .media-start,
  .media-player .media-start:hover {
    width: auto;
    height: auto;
    border-radius: 0;
    background: none;
  }

  .media-player .media-start:focus-visible {
    outline: none;
  }

  .media-start-disc {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: var(--radius-full);
    background: var(--accent);
    color: var(--on-accent);
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.3);
  }

  .media-player .media-start-disc svg {
    width: 40px;
    height: 40px;
    margin-left: 4px;
  }

  .media-start:hover .media-start-disc {
    filter: brightness(0.92);
  }

  .media-start:focus-visible .media-start-disc {
    outline: 3px solid var(--surface);
    outline-offset: 2px;
  }

  /* Video: once it plays, the bar floats over the bottom of the picture on
     the site's surface colour. */
  .media-player[data-kind="video"] .media-bar,
  .media-player[data-kind="online"] .media-bar {
    position: absolute;
    inset: auto var(--space-xs) var(--space-xs);
    padding: var(--space-3xs);
    border-radius: var(--radius-full);
    background: var(--surface);
    box-shadow: 0 2px 12px rgb(0 0 0 / 0.25);
    transition: opacity 0.2s ease-out;
  }

  .media-player[data-idle] {
    cursor: none;
  }

  .media-player[data-idle] .media-bar {
    opacity: 0;
    pointer-events: none;
  }

  .media-speed {
    padding-inline: var(--space-2xs);
  }

  /* A narrow player puts the timeline on a row of its own above the
     buttons, so every button stays. */
  .media-player[data-kind="video"][data-narrow] .media-bar,
  .media-player[data-kind="online"][data-narrow] .media-bar {
    flex-wrap: wrap;
    border-radius: var(--radius-l);
  }

  .media-player[data-narrow] .media-timeline {
    flex-basis: 100%;
    order: -1;
    padding-inline: var(--space-2xs);
  }

  .media-player[data-narrow] .media-mute {
    margin-left: auto;
  }

  /* The total time stays in the timeline's spoken value. */
  .media-player[data-narrow] .media-timeline + .media-time {
    display: none;
  }

  /* Full screen: the picture letterboxed on black, the bar at the bottom. */
  .media-player:fullscreen {
    display: grid;
    background: #000;
  }

  .media-player:fullscreen > video {
    object-fit: contain;
  }

  .media-player:-webkit-full-screen {
    display: grid;
    width: 100%;
    height: 100%;
    background: #000;
  }

  .media-player:-webkit-full-screen > video {
    object-fit: contain;
  }

  /* Online video (YouTube, Vimeo) without the script: a link to the video
     showing its still and the same play button as the site's videos. */
  .online-video {
    position: relative;
    display: block;
  }

  .online-video > img,
  .media-player[data-kind="online"] > img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .online-video::before,
  .online-video::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
  }

  .online-video::before {
    width: 64px;
    height: 64px;
    margin: -32px 0 0 -32px;
    border-radius: var(--radius-full);
    background: var(--accent);
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.3);
  }

  .online-video::after {
    width: 22px;
    height: 26px;
    margin: -13px 0 0 -8px;
    background: var(--on-accent);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  .online-video:hover::before {
    filter: brightness(0.92);
  }

  .online-video:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* Online video with the script: the still covers the service's player
     until it plays; then the player shows, a clear surface over it takes
     clicks for the site's bar, and the still waits behind. Without a still
     the player keeps the usual video shape. */
  .media-player[data-kind="online"] {
    isolation: isolate;
    background: #000;
  }

  .media-player[data-kind="online"]:not(:has(> img)) {
    aspect-ratio: 16 / 9;
  }

  .media-player[data-kind="online"] > img {
    position: relative;
    z-index: 1;
  }

  .media-player[data-kind="online"][data-started] > img,
  .media-player[data-kind="online"][data-state="service"] > img {
    z-index: -1;
  }

  .media-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    pointer-events: none;
  }

  .media-player[data-state="service"] > .media-frame {
    pointer-events: auto;
  }

  .media-surface {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .media-player:not([data-started]) > .media-surface,
  .media-player[data-state="service"] > .media-surface {
    display: none;
  }

  .media-player[data-kind="online"] > .media-start,
  .media-player[data-kind="online"] > .media-bar {
    z-index: 2;
  }

  /* While the service loads, the play button breathes. */
  .media-start[aria-busy="true"] .media-start-disc {
    animation: media-loading 1.2s ease-in-out infinite alternate;
  }

  @keyframes media-loading {
    to {
      opacity: 0.6;
    }
  }

  .media-player:fullscreen[data-kind="online"] > img {
    object-fit: contain;
  }

  /* The service cannot be reached (offline, or blocked by the browser): one
     line and a link to the service, centred on the still. */
  .media-blocked {
    position: absolute;
    inset: 0;
    z-index: 2;
    inline-size: fit-content;
    max-inline-size: calc(100% - 2 * var(--space-xs));
    block-size: fit-content;
    margin: auto;
    padding: var(--space-2xs) var(--space-s);
    border-radius: var(--radius-l);
    background: var(--surface);
    box-shadow: 0 2px 12px oklch(0 0 none / 0.25);
    font-size: var(--text-s);
    text-align: center;
    text-wrap: balance;
  }

  .media-blocked a {
    position: relative;
    color: var(--accent);
    font-weight: 600;
  }

  /* A tap target of at least 44px around the short link. */
  .media-blocked a::after {
    content: "";
    position: absolute;
    inset: min(0px, (100% - 44px) / 2);
  }

  .media-blocked a:active {
    color: color-mix(in oklch, var(--accent), var(--ink) 30%);
  }

  /* Looping video: the picture fills its place (a picture spot sets the
     shape); one small round button in the corner. */
  .media-player[data-kind="loop"] > video {
    object-fit: cover;
  }

  .media-corner {
    position: absolute;
    right: var(--space-xs);
    bottom: var(--space-xs);
    z-index: 1;
  }

  .media-player .media-corner,
  .media-corner {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    color: var(--ink);
    box-shadow: 0 1px 6px rgb(0 0 0 / 0.25);
    cursor: pointer;
  }

  .media-player .media-corner:hover,
  .media-corner:hover {
    background: var(--surface);
  }

  .media-corner svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .media-corner:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Background video: fills its section behind the text. */
  :has(> video[data-background]) {
    position: relative;
    isolation: isolate;
  }

  video[data-background] {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  /* Audio: a card on the site's surface. */
  .media-player[data-kind="audio"] {
    display: grid;
    gap: var(--space-2xs);
    max-width: var(--reading-width);
    padding: var(--space-2xs) var(--space-xs);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface);
  }

  .media-player .media-transcript-toggle {
    justify-self: start;
    min-width: 0;
    height: auto;
    padding: var(--space-3xs) var(--space-2xs);
    border-radius: var(--radius-s);
    color: var(--accent);
    font-weight: 400;
    text-decoration: underline;
  }

  .media-transcript {
    display: grid;
    gap: var(--space-2xs);
    max-height: 16rem;
    overflow: auto;
    padding: var(--space-2xs);
    border-top: 1px solid var(--line);
    font-size: var(--text-s);
  }

  .media-transcript:focus-visible {
    outline-offset: -2px;
  }

  .media-transcript p {
    margin: 0;
  }

  .media-transcript a {
    color: var(--accent);
  }

  /* Download cards: the first page (or a file picture), the file's name,
     type and size, and Open (PDFs open in the browser) or Download.
       <a class="download-card" href="/media/menu.pdf">
         <img src="/media/menu.page-1.webp" alt="" width="240" height="340">
         <span class="download-card-name">Menu</span>
         <span class="download-card-meta">PDF Â· 240 KB</span>
         <span class="download-card-action">Open</span>
       </a>
     Other files carry the download attribute and read Download. */
  .download-card {
    display: grid;
    grid-template:
      "picture name action" auto
      "picture meta action" auto / 56px 1fr auto;
    align-items: center;
    column-gap: var(--space-s);
    row-gap: var(--space-3xs);
    max-width: 36rem;
    padding: var(--space-xs);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--surface);
    color: var(--ink);
    font-family: var(--font-body);
    text-decoration: none;
  }

  .download-card > img,
  .download-card:not(:has(> img))::before {
    grid-area: picture;
    width: 56px;
    height: 72px;
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    background-color: var(--page);
  }

  .download-card > img {
    object-fit: cover;
    object-position: top;
  }

  /* No picture: a page with a folded corner. */
  .download-card:not(:has(> img))::before {
    content: "";
    box-sizing: border-box;
    background-image: linear-gradient(225deg, var(--surface) 12px, var(--line) 12px 13px, transparent 13px);
  }

  .download-card-name {
    grid-area: name;
    align-self: end;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .download-card-meta {
    grid-area: meta;
    align-self: start;
    color: var(--muted);
    font-size: var(--text-s);
  }

  .download-card-action {
    grid-area: action;
    padding: var(--space-2xs) var(--space-s);
    border-radius: var(--radius-full);
    background: var(--accent);
    color: var(--on-accent);
    font-size: var(--text-s);
    font-weight: 600;
  }

  .download-card:hover {
    border-color: var(--accent);
  }

  .download-card:hover .download-card-action {
    filter: brightness(0.92);
  }

  .download-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (width < 30rem) {
    .download-card {
      grid-template:
        "picture name" auto
        "picture meta" auto
        "picture action" auto / 56px 1fr;
    }

    .download-card-action {
      justify-self: start;
      margin-top: var(--space-3xs);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .media-player[data-kind="video"] .media-bar,
    .media-player[data-kind="online"] .media-bar {
      transition: none;
    }

    .media-start[aria-busy="true"] .media-start-disc {
      animation: none;
    }
  }
}
/* Sections written directly in a page, as opposed to section-* components. */
@layer sections {
  .hero h1 {
    max-width: 24ch;
  }

  .lead {
    font-size: var(--text-l);
    line-height: 1.6;
    color: var(--muted);
  }

  /* A link styled as a button, including inside a .flow block, and the
     links in a row of buttons (.cta). In a brand or accent band the accent
     roles invert, so the button does too. */
  .btn,
  .cta a {
    display: inline-block;
    padding: var(--space-xs) var(--space-m);
    border: 2px solid var(--accent);
    border-radius: var(--radius-full);
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
    text-decoration: none;
  }

  .btn:hover,
  .cta a:hover {
    filter: brightness(0.92);
  }

  /* A row of buttons: the first link is the main action, any after it are
     outlined. Used under the home hero. */
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .flow > .cta {
    margin-top: var(--space-l);
  }

  .cta a + a {
    background: transparent;
    color: var(--accent);
  }

  .cta a + a:hover {
    background: var(--surface);
    filter: none;
  }

  /* Numbered steps in a row, three across where there is room. */
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-l);
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps li {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    counter-increment: step;
  }

  .steps li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: var(--space-xl);
    height: var(--space-xl);
    border-radius: var(--radius-full);
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 700;
  }

  .steps h3 {
    font-size: var(--text-l);
  }

  .steps p {
    color: var(--muted);
  }

  .approach,
  .contact {
    padding: var(--space-xl);
    border-radius: var(--radius-l);
    background: var(--surface);
  }
}
/* The site's shared styles, in cascade order. The layer order comes first
   (tokens.css declares it too), so each file's @layer block lands in its
   place whatever order the rules are read in. The imports are not put in a
   layer themselves: each file wraps its rules in its own layer. A component's
   own stylesheet is not in a layer, so it wins over all of them. */
@layer tokens, elements, tones, layout, sections, utilities;
@import url("tokens.css");
@import url("elements.css");
@import url("tones.css");
@import url("layout.css");
@import url("sections.css");
@import url("utilities.css");

/* Components stay hidden until components.js has defined them, so a page
   never shows them unstyled. Only with scripting on: without JS, their
   content still shows. :not(:defined) matches custom elements only (every
   built-in element is defined); data-unloaded is the loader's mark on one it
   could not load, which then shows its own content. */
@media (scripting: enabled) {
  :not(:defined):not([data-unloaded]) {
    visibility: hidden;
  }
}
/* The layer order for every shared stylesheet. Keep this file first in
   site.css's imports so the order is set before any layer is used. A
   component's own stylesheet is not in a layer, so it wins over all of them. */
@layer tokens, elements, tones, layout, sections, utilities;

@layer tokens {
  :root {
    /* The site's one colour. tones.css derives the accent and the brand and
       accent tones from it, keeping their text readable whatever it is. */
    --brand: #2f6d3a;

    /* Colour roles. These plain values are for browsers without
       light-dark(); the pairs below give each role a light and a dark value,
       picked by color-scheme (tones.css). Where the browser has relative
       colour syntax, tones.css derives the accent from --brand; elsewhere
       it is these fixed, readable values. */
    --ink: #20231f;
    --muted: #5c665a;
    --surface: #ffffff;
    --page: #f6f7f3;
    --accent: #20231f; /* Links, buttons, focus rings: see tones.css. */
    --on-accent: #fff; /* Text on an accent background. */
    --line: #e2e6de;

    /* Type */
    --font-body: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    --text-s: 14px;
    --text-m: 16px;
    --text-l: 18px;
    --text-xl: 20px;
    --text-2xl: 24px;
    --text-3xl: clamp(24px, 3vw, 34px);
    --text-4xl: clamp(28px, 4vw, 44px);

    /* Space */
    --space-3xs: 4px;
    --space-2xs: 8px;
    --space-xs: 12px;
    --space-s: 16px;
    --space-m: 20px;
    --space-l: 24px;
    --space-xl: 32px;
    --space-2xl: 40px;
    --space-3xl: 48px;
    --space-4xl: 56px;
    --space-5xl: 80px;

    /* Shape */
    --radius-s: 4px;
    --radius-m: 12px;
    --radius-l: 16px;
    --radius-full: 999px;

    /* Measure */
    --page-width: 960px;
    --reading-width: 64ch;
  }

  @supports (color: light-dark(#000, #fff)) {
    :root {
      --ink: light-dark(#20231f, #e6e9e2);
      --muted: light-dark(#5c665a, #a8b1a5);
      --surface: light-dark(#ffffff, #20241e);
      --page: light-dark(#f6f7f3, #161915);
      --accent: light-dark(#20231f, #e6e9e2);
      --on-accent: light-dark(#fff, #161915);
      --line: light-dark(#e2e6de, #353b32);
    }
  }
}
/* Colour from the one brand colour (--brand in tokens.css), and the tones a
   page band takes with data-tone: light, dark, brand and accent. The page,
   and a band without a tone, follow the visitor's setting. Text keeps at
   least 4.5:1 (WCAG AA) against its band and buttons at least 3:1, whatever
   --brand is: the editor's shared/tone.ts proves these formulas over every
   brand colour. Written by hand, the rules work on any element; the editor
   offers them on page bands only (section components, plain sections, the
   header and the footer). */
@layer tones {
  /* The page follows the visitor's setting where the colour roles in
     tokens.css can (they are light-dark() pairs); without light-dark() it
     stays light, so dark form controls never sit on the light palette. */
  :root {
    color-scheme: light;
  }

  @supports (color: light-dark(#000, #fff)) {
    :root {
      color-scheme: light dark;
    }
  }

  /* Every band paints its own background and text from the colour roles. */
  [data-tone="light"],
  [data-tone="dark"],
  [data-tone="brand"],
  [data-tone="accent"] {
    background-color: var(--page);
    color: var(--ink);
  }

  /* A band in the page's column reaches the window's edges: border-image
     draws its background past both sides without widening the page. */
  main > :is([data-tone="light"], [data-tone="dark"], [data-tone="brand"], [data-tone="accent"]) {
    padding-block: var(--space-3xl);
    border-image: conic-gradient(var(--page) 0 0) fill 0 / / 0 100vmax;
  }

  /* Light and dark flip the colour roles' light-dark() pairs. */
  [data-tone="light"] {
    color-scheme: light;
  }

  [data-tone="dark"] {
    color-scheme: dark;
  }

  /* Browsers without light-dark() take the dark values of tokens.css
     directly. */
  @supports not (color: light-dark(#000, #fff)) {
    [data-tone="dark"] {
      --ink: #e6e9e2;
      --muted: #a8b1a5;
      --surface: #20241e;
      --page: #161915;
      --accent: #e6e9e2;
      --on-accent: #161915;
      --line: #353b32;
    }
  }

  /* Brand and accent: everything in the band takes the surface and its
     text. Buttons invert (their fill is the text colour, their label the
     surface); links take the text colour, underlined. */
  [data-tone="brand"],
  [data-tone="accent"] {
    --page: var(--tone-surface);
    --surface: var(--tone-surface);
    --ink: var(--tone-text);
    --muted: var(--tone-text);
    --accent: var(--tone-text);
    --on-accent: var(--tone-surface);
    --line: var(--tone-line);
  }

  /* Fixed colours for browsers without relative colour syntax. */
  [data-tone="brand"] {
    --tone-surface: #20231f;
    --tone-text: #ffffff;
    --tone-line: #4b5148;
  }

  [data-tone="accent"] {
    --tone-surface: #eef1ea;
    --tone-text: #20231f;
    --tone-line: #c6cdc0;
  }

  @supports (color: oklch(from red l c h)) {
    /* A gamut map into sRGB that keeps a colour's WCAG luminance, and so its
       contrast: the colour moves toward the grey of the same luminance until
       it fits; colours already in sRGB are left as they are. Write
       color(from <colour> srgb-linear calc(var(--tone-y) + var(--tone-t) *
       (r - var(--tone-y))) â€¦same for g and bâ€¦ / 1) to map <colour>. Both
       name the channels r, g and b, so they only work inside that. */
    :root {
      --tone-y: clamp(0, 0.2126 * r + 0.7152 * g + 0.0722 * b, 1);
      --tone-t: min(1,
        max(1e-9, 1 - var(--tone-y)) / max(1e-9, max(r, g, b) - var(--tone-y)),
        max(1e-9, var(--tone-y)) / max(1e-9, var(--tone-y) - min(r, g, b)));
    }

    /* Brand: the brand colour, its OKLCH lightness moved out of the middle
       band to at most 0.50 or at least 0.72 (whichever side of 0.61 it is
       on), then mapped into sRGB. */
    [data-tone="brand"] {
      --tone-raw: oklch(from var(--brand) calc(
        min(l, 0.50) * clamp(0, 1 / (0.61 - l), 1) +
        max(l, 0.72) * (1 - clamp(0, 1 / (0.61 - l), 1))) c h / 1);
      --tone-surface: color(from var(--tone-raw) srgb-linear
        calc(var(--tone-y) + var(--tone-t) * (r - var(--tone-y)))
        calc(var(--tone-y) + var(--tone-t) * (g - var(--tone-y)))
        calc(var(--tone-y) + var(--tone-t) * (b - var(--tone-y))) / 1);
    }

    /* Accent: a soft tint of the brand colour. */
    [data-tone="accent"] {
      --tone-surface: oklch(from var(--brand) 0.95 min(c, 0.04) h / 1);
    }

    /* Text: near-white on a surface darker than 0.61, near-black on a
       lighter one; the line between cards is a mix of the two. */
    [data-tone="brand"],
    [data-tone="accent"] {
      --tone-text: oklch(from var(--tone-surface)
        calc(0.99 + (0.01 - 0.99) * (1 - clamp(0, 1 / (0.61 - l), 1))) 0 0 / 1);
      --tone-line: color-mix(in oklab, var(--tone-text) 30%, var(--tone-surface));
    }

    /* The accent colour (links, buttons, focus rings) for the page and the
       light and dark tones: the brand colour at OKLCH lightness 0.50 or
       below on light, 0.72 or above on dark, mapped into sRGB. It keeps
       4.5:1 against the page and surface colours in tokens.css, and white or
       black button labels on it more. */
    @supports (color: light-dark(#000, #fff)) {
      :root {
        --accent: light-dark(
          color(from oklch(from var(--brand) min(l, 0.50) c h / 1) srgb-linear
            calc(var(--tone-y) + var(--tone-t) * (r - var(--tone-y)))
            calc(var(--tone-y) + var(--tone-t) * (g - var(--tone-y)))
            calc(var(--tone-y) + var(--tone-t) * (b - var(--tone-y))) / 1),
          color(from oklch(from var(--brand) max(l, 0.72) c h / 1) srgb-linear
            calc(var(--tone-y) + var(--tone-t) * (r - var(--tone-y)))
            calc(var(--tone-y) + var(--tone-t) * (g - var(--tone-y)))
            calc(var(--tone-y) + var(--tone-t) * (b - var(--tone-y))) / 1));
        --on-accent: light-dark(#ffffff, #000000);
      }
    }
  }

  /* Where the browser has contrast-color(), it picks the text instead. */
  @supports (color: contrast-color(red)) {
    [data-tone="brand"],
    [data-tone="accent"] {
      --tone-text: contrast-color(var(--tone-surface));
    }
  }
}
/* Classes that win over the element, layout and section styles: the
   utilities layer comes last. The skip link every page carries, then the
   text sizes the editor's Text size control offers. Each text class sets one
   step of the type scale in tokens.css; the editor writes the class on the
   element. */
@layer utilities {
  /* Each page's "Skip to content" link, right before <site-header>. Off
     screen until it takes keyboard focus, then above the sticky header. It
     points at <main id="main">. */
  .skip {
    position: absolute;
    z-index: 3;
    top: var(--space-2xs);
    left: var(--space-2xs);
    padding: var(--space-2xs) var(--space-s);
    border-radius: var(--radius-s);
    background: var(--ink);
    color: var(--surface);
    font-weight: 600;
    transform: translateY(-200%);
  }

  .skip:focus {
    transform: none;
  }

  .text-s { font-size: var(--text-s); }
  .text-m { font-size: var(--text-m); }
  .text-l { font-size: var(--text-l); }
  .text-xl { font-size: var(--text-xl); }
  .text-2xl { font-size: var(--text-2xl); }
  .text-3xl { font-size: var(--text-3xl); }
  .text-4xl { font-size: var(--text-4xl); }
}
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Fern &amp; Kettle Â· Larkspur Studio</title>
  <meta name="description" content="A one-page site for a neighbourhood cafe, with a printable menu the owners update themselves each morning.">
  <meta name="robots" content="noindex">
  <link rel="canonical" href="https://native-site-editor-starter-test.lexvd.workers.dev/work/fern-and-kettle/">
  <meta name="theme-color" content="#2f6d3a">
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Larkspur Studio">
  <meta property="og:title" content="Fern &amp; Kettle Â· Larkspur Studio">
  <meta property="og:description" content="A one-page site for a neighbourhood cafe, with a printable menu the owners update themselves each morning.">
  <meta property="og:url" content="https://native-site-editor-starter-test.lexvd.workers.dev/work/fern-and-kettle/">
  <meta property="og:locale" content="en_GB">
  <meta property="og:image" content="https://native-site-editor-starter-test.lexvd.workers.dev/images/social-card.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Larkspur Studio: small, editable websites for independent businesses, Frome, Somerset">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="stylesheet" href="/styles/site.css">
  <script type="module" src="/components/components.js"></script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <site-header></site-header>
  <main class="page" id="main">
    <section class="hero flow">
      <card-note><p slot="text">Cafe Â· Identity and site Â· 2025</p></card-note>
      <h1>Fern &amp; Kettle</h1>
      <p class="lead">A one-page site with a menu the owners change themselves before opening each morning.</p>
    </section>
    <section class="prose flow">
      <h2>The brief</h2>
      <p>Fern &amp; Kettle opened with a chalkboard menu and a social media account that nobody had time to update. Customers kept asking whether the cafe did breakfast, which it did, and whether it took bookings, which it did too.</p>
      <h2>What we built</h2>
      <p>A single page with the opening hours at the top, the menu below, and a booking link that goes straight to the cafe's existing calendar. The menu prints cleanly on one sheet, so the counter copy and the website are always the same.</p>
      <h2>Since launch</h2>
      <p>The owners update the menu most mornings in a couple of minutes. Phone calls asking about opening hours have mostly stopped.</p>
      <p><a href="/#work">Back to all work</a></p>
    </section>
    <section-contact>
      <h2 slot="title">Need something similar?</h2>
      <p slot="body" class="body">Tell us what your site needs to do and we will reply within a few days.</p>
      <a slot="action" href="/about/#contact">Start a project</a>
    </section-contact>
  </main>
  <site-footer></site-footer>
</body>
</html>
