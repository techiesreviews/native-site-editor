<body>
  <header class="site-header">
    <a class="skip" href="#main">Skip to content</a>
    <a class="brand" href="/" aria-current="page">Larkspur</a>
    <nav aria-label="Main">
      <a href="/#work">Work</a>
      <a href="/about/">About</a>
    </nav>
  </header>
  <main class="page" id="main">
    <section class="section-hero">
      <p class="eyebrow">Larkspur Studio</p>
      <h1>A short, clear headline for the page.</h1>
      <p class="lead">One or two sentences that say who this is for and what they get.</p>
      <div class="actions">
        <a href="/about/#contact">Get in touch</a>
        <a href="#work">See our work</a>
      </div>
    </section>
    <section class="section-feature">
      <h2>What we offer</h2>
      <div class="items">
        <article>
          <h3>First item</h3>
          <p>A sentence or two about this item.</p>
        </article>
        <article>
          <h3>Second item</h3>
          <p>A sentence or two about this item.</p>
        </article>
        <article>
          <h3>Third item</h3>
          <p>A sentence or two about this item.</p>
        </article>
      </div>
    </section>
    <section class="flow" id="work">
      <h2>Recent work</h2>
      <div class="cards">
        <article class="card-project">
          <p class="card-note">Cafe · Identity and site · 2025</p>
          <h3>Fern &amp; Kettle</h3>
          <p class="body">A one-page site with a menu the owners change themselves before opening each morning.</p>
          <p class="actions"><a href="/work/fern-and-kettle/">Read about Fern &amp; Kettle</a></p>
        </article>
        <article class="card-project">
          <p class="card-note">Ceramics studio · Portfolio · 2025</p>
          <h3>Harbour Lane Pottery</h3>
          <p class="body">A quiet portfolio for a working potter, with large photographs and a dates page for kiln openings.</p>
          <p class="actions"><a href="/work/harbour-lane-pottery/">Read about Harbour Lane Pottery</a></p>
        </article>
        <article class="card-project">
          <p class="card-note">Community group · Notices and rules · 2024</p>
          <h3>Meadow Row Allotments</h3>
          <p class="body">A small site for forty plot holders: rules, a plot map, seasonal notices, and a way to reach the committee.</p>
          <p class="actions"><a href="/work/meadow-row-allotments/">Read about Meadow Row Allotments</a></p>
        </article>
      </div>
    </section>
    <section class="section-contact">
      <h2>Have a project in mind?</h2>
      <p class="body">Tell us what the site needs to do and we will reply within a few days.</p>
      <p class="action"><a href="/about/#contact">Get in touch</a></p>
    </section>
  </main>
  <footer class="site-footer">
    <address>
      <p>Larkspur Studio, Frome, Somerset. Designed and built by hand.</p>
      <p><a href="mailto:hello@larkspur.example">hello@larkspur.example</a></p>
    </address>
    <nav aria-label="Footer">
      <a href="/#work">Work</a>
      <a href="/about/">About</a>
    </nav>
  </footer>
