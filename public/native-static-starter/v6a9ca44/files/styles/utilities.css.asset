/* Text sizes the editor's Text size control offers. Each class sets one step
   of the type scale in tokens.css; the editor writes the class on the
   element. The utilities layer comes last, so a class wins over the
   element, layout and section styles. */
@layer utilities {
  .text-s { font-size: var(--text-s); }
  .text-m { font-size: var(--text-m); }
  .text-l { font-size: var(--text-l); }
  .text-xl { font-size: var(--text-xl); }
  .text-2xl { font-size: var(--text-2xl); }
  .text-3xl { font-size: var(--text-3xl); }
  .text-4xl { font-size: var(--text-4xl); }
}
