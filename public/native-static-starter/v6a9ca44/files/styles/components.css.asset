/* Site-wide parts and page sections written straight into each page as plain
   HTML: the header, the footer, the hero, the feature list, the project cards
   and the contact panel. site.css imports this file into the components
   layer: it wins over elements, layout and sections, and the utilities layer
   (text-size classes) wins over it. Each part is scoped by its own class. */

/* Header. It sticks to the top of the page while scrolling. The side padding
   lines the content up with the page's own width. */
.site-header {
  position: sticky;
  top: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-3xs) max(var(--space-l), (100% - var(--page-width)) / 2);
  background: var(--surface);
  border-bottom: 1px solid var(--line);
}

/* Off screen until it takes keyboard focus. It points at <main id="main">. */
.site-header .skip {
  position: absolute;
  top: var(--space-2xs);
  left: var(--space-2xs);
  padding: var(--space-2xs) var(--space-s);
  border-radius: var(--radius-s);
  background: var(--ink);
  color: var(--surface);
  font-weight: 600;
  transform: translateY(-200%);
}

.site-header .skip:focus {
  transform: none;
}

.site-header .brand {
  font-weight: 700;
  font-size: var(--text-l);
  color: var(--ink);
  text-decoration: none;
}

.site-header nav {
  display: flex;
  gap: var(--space-2xs);
}

/* Padded to a 48px tap target. */
.site-header nav a {
  padding: var(--space-xs) var(--space-2xs);
  color: var(--muted);
  text-decoration: none;
  font-weight: 600;
}

.site-header nav a:hover {
  color: var(--accent);
}

/* The link for the page being shown carries aria-current="page". */
.site-header nav a[aria-current="page"] {
  color: var(--ink);
  text-decoration: underline;
  text-decoration-thickness: 2px;
  text-underline-offset: 6px;
}

/* Footer. */
.site-footer {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--space-s) var(--space-l);
  padding: var(--space-l) max(var(--space-l), (100% - var(--page-width)) / 2);
  background: var(--surface);
  border-top: 1px solid var(--line);
  color: var(--muted);
  font-size: var(--text-s);
}

.site-footer address {
  font-style: normal;
}

.site-footer nav {
  display: flex;
  gap: var(--space-s);
}

/* Padded to at least 24px tall, so each link is an easy target. */
.site-footer a {
  display: inline-block;
  padding-block: var(--space-3xs);
  color: var(--muted);
}

.site-footer a:hover {
  color: var(--accent);
}

/* A short label above a title: the type of work, a date. */
.card-note {
  font-size: var(--text-s);
  font-weight: 600;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  color: var(--accent);
}

/* Home page hero: eyebrow, headline, lead and a row of two buttons. */
.section-hero {
  display: flex;
  flex-direction: column;
  gap: var(--space-s);
  padding-block: var(--space-2xl);
}

.section-hero .eyebrow {
  font-size: var(--text-s);
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--accent);
}

.section-hero h1 {
  max-width: 20ch;
  font-size: var(--text-4xl);
  line-height: 1.1;
}

.section-hero .lead {
  max-width: 60ch;
  font-size: var(--text-l);
  line-height: 1.6;
  color: var(--muted);
}

.section-hero .actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs);
  margin-top: var(--space-m);
}

/* The first link is the main action; any after it are outlined. */
.section-hero .actions a {
  display: inline-block;
  padding: var(--space-xs) var(--space-m);
  border: 2px solid var(--accent);
  border-radius: var(--radius-full);
  background: var(--accent);
  color: #fff;
  font-weight: 600;
  text-decoration: none;
}

.section-hero .actions a:hover {
  filter: brightness(0.92);
}

/* The keyboard focus ring keeps the site-wide small radius (elements.css),
   as on every other link, rather than following the pill shape. */
.section-hero .actions a:focus-visible {
  border-radius: var(--radius-s);
}

.section-hero .actions a + a {
  background: transparent;
  color: var(--accent);
}

.section-hero .actions a + a:hover {
  background: var(--surface);
  filter: none;
}

@media (max-width: 720px) {
  .section-hero {
    padding-block: var(--space-xl);
  }

  .section-hero h1 {
    font-size: var(--text-3xl);
  }
}

/* A heading over three short items in a row. */
.section-feature {
  display: flex;
  flex-direction: column;
  gap: var(--space-m);
}

.section-feature h2 {
  font-size: var(--text-2xl);
}

.section-feature .items {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: var(--space-m);
}

.section-feature article {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding: var(--space-m);
  border-radius: var(--radius-l);
  background: var(--surface);
}

.section-feature h3 {
  font-size: var(--text-xl);
  line-height: 1.3;
}

.section-feature p {
  color: var(--muted);
  line-height: 1.55;
}

/* A project card. It fills its grid cell, so every card in a row is as tall
   as the tallest and the link paragraph lines up along the bottom. */
.card-project {
  box-sizing: border-box;
  height: 100%;
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding: var(--space-l);
  border-radius: var(--radius-l);
  background: var(--surface);
  border: 1px solid var(--line);
}

.card-project h3 {
  font-size: var(--text-xl);
  line-height: 1.3;
}

.card-project .body {
  color: var(--muted);
  line-height: 1.55;
}

/* The auto margin pushes the link to the bottom of the card. */
.card-project .actions {
  margin-top: auto;
  padding-top: var(--space-3xs);
  font-weight: 600;
}

.card-project .actions a {
  color: var(--accent);
}

/* A call to action on a light panel. */
.section-contact {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding: var(--space-xl);
  border-radius: var(--radius-l);
  background: var(--surface);
}

.section-contact h2 {
  font-size: var(--text-2xl);
}

.section-contact .body {
  max-width: var(--reading-width);
  color: var(--muted);
  line-height: 1.55;
}

.section-contact .action {
  font-weight: 600;
}

.section-contact .action a {
  color: var(--accent);
}
