@layer elements {
  /* A link to a part of a page (/#work, /about/#contact) scrolls it clear of
     the sticky header. */
  html {
    scroll-padding-top: var(--space-5xl);
  }

  body {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-m);
    line-height: 1.5;
    color: var(--ink);
    background: var(--page);
  }

  /* No margins on elements. Spacing comes from the container: .flow, or the
     gap of a section or card in components.css. */
  h1, h2, h3, h4, h5, h6, p, ul, ol, dl, dd, figure, blockquote, pre, address {
    margin: 0;
  }

  /* Sections and cards in components.css size their own headings; the
     components layer comes after this one, so those rules win. */
  h1 {
    font-size: var(--text-4xl);
    line-height: 1.15;
  }

  h2 {
    font-size: var(--text-2xl);
  }

  /* Links in running text. Buttons and navigation set their own colour. */
  p a,
  li a {
    color: var(--accent);
  }

  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: var(--radius-s);
  }
}
